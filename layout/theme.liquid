<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="theme-color" content="#4a88ab">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'app-icon.svg' | asset_url }}">
  {%- endif -%}

  {%- comment -%}
    Título SEO. En la home, si en el admin no se cargó un «Homepage title»
    propio, page_title trae solo el nombre de la tienda y queda un título
    inútil para buscar: se completa con el servicio y la ciudad.
  {%- endcomment -%}
  <title>
    {%- if request.page_type == 'index' and page_title == shop.name -%}
      {{ shop.name }} · Kinesiología a domicilio en Santiago
    {%- else -%}
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless -%}
    {%- endif -%}
  </title>

  {%- comment -%}
    Descripción: la del admin de Shopify si está cargada; si no, un texto por
    defecto para que la home nunca salga sin descripción en Google.
  {%- endcomment -%}
  {%- assign default_description = 'Kinesiología a domicilio en Santiago: terapia respiratoria para adulto mayor y pediátrica, rehabilitación y terapia manual. Agenda por WhatsApp y te atendemos en tu casa.' -%}
  {%- if page_description != blank -%}
    {%- assign meta_description = page_description -%}
  {%- elsif request.page_type == 'index' -%}
    {%- assign meta_description = default_description -%}
  {%- else -%}
    {%- assign meta_description = shop.description | default: default_description -%}
  {%- endif -%}
  <meta name="description" content="{{ meta_description | strip_html | escape }}">

  {%- comment -%}
    Open Graph y Twitter: sin esto el enlace se comparte por WhatsApp sin
    imagen ni texto, que es justo por donde se difunde este sitio.
  {%- endcomment -%}
  {%- capture og_title -%}
    {%- if request.page_type == 'index' -%}{{ shop.name }} · Kinesiología a domicilio en Santiago{%- else -%}{{ page_title }}{%- endif -%}
  {%- endcapture -%}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_CL">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ og_title | strip | escape }}">
  <meta property="og:description" content="{{ meta_description | strip_html | escape }}">
  <meta property="og:image" content="{{ 'social-share.png' | asset_url | prepend: 'https:' | split: '?' | first }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ shop.name | escape }} — kinesiología a domicilio en Santiago">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title | strip | escape }}">
  <meta name="twitter:description" content="{{ meta_description | strip_html | escape }}">
  <meta name="twitter:image" content="{{ 'social-share.png' | asset_url | prepend: 'https:' | split: '?' | first }}">

  {%- comment -%} Fuentes {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  {{ 'styles.css' | asset_url | stylesheet_tag }}

  {%- render 'seo-jsonld' -%}

  {%- comment -%} REQUERIDO por Shopify: inyecta scripts, Open Graph, etc. {%- endcomment -%}
  {{ content_for_header }}

  <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-PSZ078F4G6"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-PSZ078F4G6');
</script>

<meta name="google-site-verification" content="eJXevKCyEM767n18XqoUE6Mtr1YYgcYSKDLLOfmW7HI" />

</head>

<body class="template-{{ request.page_type | handle }}">
  {%- comment -%} Datos para el JS del cotizador y WhatsApp {%- endcomment -%}
  <script id="data-config" type="application/json">
    {
      "whatsapp": {{ settings.whatsapp_number | json }},
      "whatsappMensaje": {{ settings.whatsapp_message | json }},
      "recargoFueraHorario": {{ settings.after_hours_surcharge | default: 0 | json }}
    }
  </script>

  {% section 'header' %}

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {%- comment -%} Botón flotante de WhatsApp {%- endcomment -%}
  <a href="{% render 'wa-link' %}" class="wa-float" target="_blank" rel="noopener" aria-label="Agendar por WhatsApp">
    {% render 'icon-whatsapp' %}
  </a>

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
