{%- comment -%}
  Ícono de beneficio — mismo trazo que el isotipo.
  Si el valor no corresponde a un ícono conocido se imprime tal cual
  (así siguen funcionando los emojis que hubiera cargados en el Personalizador).
  Uso: {% render 'benefit-icon', icon: block.settings.icon %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'home' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4.5 15.5V11L12 4.6l7.5 6.4v4.5"/>
      <path d="M1.4 15.5h5l1-1.6 1 1.6 1.5-7 1.5 10.4 1.2-6.4 1 3.8.8-1.4.7.6h6.5"/>
    </svg>
  {%- when 'stethoscope' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M5 3v5a4 4 0 008 0V3"/>
      <path d="M3.4 3h3M11.6 3h3"/>
      <path d="M9 12v2.6a4.6 4.6 0 009.2 0v-2"/>
      <circle cx="18.4" cy="10.2" r="2.2"/>
    </svg>
  {%- when 'calendar' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="3.2" y="5" width="17.6" height="15.8" rx="2.6"/>
      <path d="M3.2 9.8h17.6M7.8 3v4M16.2 3v4"/>
      <path d="M7 15.2h2.4l1-2 1.4 4 1.2-3 .8 1.6h2.8"/>
    </svg>
  {%- when 'card' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="2.6" y="5.2" width="18.8" height="13.6" rx="2.6"/>
      <path d="M2.6 9.8h18.8M6.4 14.8h4"/>
    </svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3.2l7 2.6v5.6c0 4.3-2.9 7.6-7 9.4-4.1-1.8-7-5.1-7-9.4V5.8l7-2.6z"/>
      <path d="M8.6 12.2l2.2 2.4 4.6-4.8"/>
    </svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8.8"/>
      <path d="M12 6.8V12l3.4 2.2"/>
    </svg>
  {%- when 'pulse' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M2.4 12h4.8l1.4-3.4 2 8.2 2.2-12.4 1.8 9.2 1.2-1.6h5.8"/>
    </svg>
  {%- when 'user' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="7.6" r="3.8"/>
      <path d="M4.8 20.4a7.2 7.2 0 0114.4 0"/>
    </svg>
  {%- else -%}
    {%- if icon != blank -%}<span class="strip-emoji">{{ icon }}</span>{%- endif -%}
{%- endcase -%}
