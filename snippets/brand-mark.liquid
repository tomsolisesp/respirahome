{%- comment -%}
  Isotipo RespiraHome: casa + pulso. Hereda el color del contexto (currentColor).
  Uso:
    {% render 'brand-mark', size: 40, class: 'brand-logo', decorative: true %}
    {% render 'brand-mark', size: 96, animate: true %}   ← dibuja el pulso
{%- endcomment -%}
{%- assign px = size | default: 40 -%}
<svg class="brand-mark{% if animate %} is-animated{% endif %}{% if class != blank %} {{ class }}{% endif %}"
     viewBox="0 0 48 48" width="{{ px }}" height="{{ px }}"
     fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"
     {% if decorative or animate %}aria-hidden="true" focusable="false"{% else %}role="img" aria-label="{{ label | default: 'RespiraHome' }}"{% endif %}>
  <path class="brand-mark-house" d="M8 32V23.6L24 9l16 14.6V32"/>
  <path class="brand-mark-pulse" d="M3 32h10.5l2-3.2 2 3.2 3-15 3 22 2.5-13.5 2 8 1.5-3 1.5 1.5H45"/>
</svg>
