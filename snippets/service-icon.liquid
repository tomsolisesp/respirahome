{%- comment -%}
  Ícono de servicio — trazo abierto, mismo lenguaje gráfico que el isotipo
  (stroke, extremos redondeados, sin relleno). El grosor y el color vienen del CSS.
  Uso: {% render 'service-icon', icon: block.settings.icon %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'baby' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="7.4" r="4.2"/>
      <path d="M11.9 3.3c1-.9 2.5-.4 2.5.9"/>
      <path d="M10.4 7h.01M13.6 7h.01"/>
      <path d="M10.5 9.1a2.3 2.3 0 003 0"/>
      <path d="M6.6 21v-1.6a5.4 5.4 0 015.4-5.4 5.4 5.4 0 015.4 5.4V21"/>
    </svg>
  {%- when 'muscle' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M3 9.6v4.8M6.4 7.4v9.2M17.6 7.4v9.2M21 9.6v4.8"/>
      <path d="M6.4 12h11.2"/>
    </svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 20.4C9.3 18.6 3.6 14.9 3.6 10.2A4.4 4.4 0 0112 8.1a4.4 4.4 0 018.4 2.1c0 4.7-5.7 8.4-8.4 10.2z"/>
      <path d="M6.4 11.6h2.5l1.3-2.4 1.9 4.6 1.4-2.2h3.6"/>
    </svg>
  {%- when 'hand' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M9 11.4V4a1.3 1.3 0 012.6 0v6.4"/>
      <path d="M11.6 10.4V5.4A1.3 1.3 0 0114.2 5.4v5"/>
      <path d="M14.2 10.8V7.6a1.3 1.3 0 012.6 0v6"/>
      <path d="M9 11.4V9.2a1.3 1.3 0 00-2.6 0v6.4l-1.6-1.7a1.3 1.3 0 00-1.9 1.8l3 3.4A5.6 5.6 0 0011 21h1.4c2.5 0 4.4-2 4.4-4.5"/>
    </svg>
  {%- when 'house' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4.5 15.5V11L12 4.6l7.5 6.4v4.5"/>
      <path d="M1.4 15.5h5l1-1.6 1 1.6 1.5-7 1.5 10.4 1.2-6.4 1 3.8.8-1.4.7.6h6.5"/>
    </svg>
  {%- else -%}
    {%- comment -%} lungs (respiratorio) — por defecto {%- endcomment -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3.6v5.8"/>
      <path d="M12 9.4l-1.1 3.2M12 9.4l1.1 3.2"/>
      <path d="M10.9 12.6v6.2c0 1.3-1 2.3-2.3 2.3H7.4A2.4 2.4 0 015 18.7c0-3 1.1-5.8 3-7.8 1-1 2.9-.3 2.9 1.1z"/>
      <path d="M13.1 12.6v6.2c0 1.3 1 2.3 2.3 2.3h1.2a2.4 2.4 0 002.4-2.4c0-3-1.1-5.8-3-7.8-1-1-2.9-.3-2.9 1.1z"/>
    </svg>
{%- endcase -%}
